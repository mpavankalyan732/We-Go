<?xml version="1.0" encoding="UTF-8"?>
<!--
  Points at the RoadLink Bus API (bus-booking-app/api). BusApiClient.cls calls
  this via `callout:Bus_API/api/...` for booking lookup, reschedule/cancel
  eligibility, and performing reschedules/cancellations.

  IMPORTANT - Salesforce's servers cannot reach http://localhost:4000. The
  endpoint below must point at a PUBLICLY reachable instance of the Bus API
  before any of BusApiClient's callouts will work:
    - deploy it (see bus-booking-app/api/README.md "Deploying to Render"), or
    - tunnel your local instance for testing (e.g. ngrok http 4000)
  and paste that base URL here (include the trailing /api used by every
  route, e.g. https://roadlink-bus-api.onrender.com/api).

  Auth: protocol is NoAuthentication - BusApiClient sets the x-api-key header
  itself on every request, reading the key from the Bus_Api_Config__mdt
  "Default" record (Setup > Custom Metadata Types > Bus Api Config > Manage
  Records). Leave that record's Api_Key__c blank to match the Bus API running
  with auth disabled (API_KEY unset in its .env).
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <calloutStatus>Enabled</calloutStatus>
    <endpoint>https://TODO-deploy-or-tunnel-the-bus-api.example.com/api</endpoint>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <label>Bus API</label>
    <principalType>Anonymous</principalType>
    <protocol>NoAuthentication</protocol>
</NamedCredential>
