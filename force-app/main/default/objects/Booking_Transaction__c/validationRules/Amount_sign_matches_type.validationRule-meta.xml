<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_sign_matches_type</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
  AND(TEXT(Transaction_Type__c) = &quot;Payment&quot;, Amount__c &lt; 0),
  AND(TEXT(Transaction_Type__c) = &quot;Refund&quot;, Amount__c &gt; 0)
)</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>payment transactions must have a positive amount, and Refund transactions must have a negative amount.</errorMessage>
</ValidationRule>
