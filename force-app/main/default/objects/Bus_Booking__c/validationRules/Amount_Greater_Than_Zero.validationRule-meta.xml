<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Greater_Than_Zero</fullName>
    <active>true</active>
    <errorConditionFormula>Total_Amount__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Total_Amount__c</errorDisplayField>
    <errorMessage>Total Amount must be greater than or equal to 0.</errorMessage>
</ValidationRule>
