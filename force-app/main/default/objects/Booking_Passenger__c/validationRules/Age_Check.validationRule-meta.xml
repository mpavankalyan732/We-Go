<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Age_Check</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Age__c &lt; 1, Age__c &gt; 120)</errorConditionFormula>
    <errorDisplayField>Age__c</errorDisplayField>
    <errorMessage>Age must be between 1 and 100.</errorMessage>
</ValidationRule>
