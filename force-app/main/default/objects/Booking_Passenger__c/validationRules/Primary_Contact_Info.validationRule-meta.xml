<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Primary_Contact_Info</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Is_Primary_Contact__c = TRUE, ISBLANK(Email__c))</errorConditionFormula>
    <errorDisplayField>Email__c</errorDisplayField>
    <errorMessage>Email is required when Is Primary Contact is selected.</errorMessage>
</ValidationRule>
