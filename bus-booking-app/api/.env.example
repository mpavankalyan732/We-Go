# Copy to .env for local development.

PORT=4000

# Leave blank locally to disable auth. Set this (and send it as the x-api-key
# header) once you're ready to lock the API down for the website / Salesforce.
API_KEY=

# Optional — defaults to ./data/bus_booking.sqlite. Point this at a Render
# persistent disk mount path in production if you need data to survive
# redeploys (see README "Deployment").
DB_PATH=

# Salesforce sync — pushed right after every booking is created (see README
# "Salesforce sync"). Uses the OAuth 2.0 Client Credentials Flow via the
# RoadLink_Bus_Integration External Client App
# (force-app/main/default/externalClientApps). Leave these blank to skip the
# sync entirely — booking creation still works fine either way.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_LOGIN_URL=https://login.salesforce.com
